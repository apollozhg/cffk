{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "cffk",
  "compatibility_date": "2026-03-12",
  "main": "vike:server-entry",
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cffk_db",
      "database_id": "5f893bc3-20f9-4fd7-adfe-dc0d714944db",  
      "migrations_dir": "database/migrations"
    }
  ],
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
